# ─── Supabase ───────────────────────────────────────────────
# URL del proyecto (sin /rest/v1/ al final)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clave service_role — SOLO server-side, nunca exponer al cliente
SUPABASE_SERVICE_ROLE_KEY=

# ─── MercadoPago (Checkout Pro) ─────────────────────────────
# Mercado Pago Connect: Client ID y Client Secret de la APLICACIÓN de MP del
# desarrollador (una sola, sirve para cualquier tienda). La tienda conecta SU
# cuenta desde /admin/cobros y la plata cae en la cuenta de ella.
# En la aplicación hay que registrar la Redirect URI:
#   <NEXT_PUBLIC_SITE_URL>/admin/cobros/callback
MP_CLIENT_ID=
MP_CLIENT_SECRET=
# SOLO para desarrollo local, con un usuario de prueba. En producción va vacío:
# si la tienda no conectó su cuenta, se usa este, y uno equivocado cobraría en
# otra cuenta. Ojo: que empiece con APP_USR- no garantiza que sea de producción.
MP_ACCESS_TOKEN=
# Clave secreta del webhook. Se genera en el panel de MercadoPago →
# "Tus integraciones" → la aplicación → Webhooks → "Generar clave secreta".
# Sirve para comprobar que la notificación la mandó MP de verdad.
# OPCIONAL: si está vacía, el webhook igual funciona (deja un aviso en el log).
# Se hizo así a propósito — si faltara y el webhook rechazara todo, ningún pago
# se confirmaría, que es el desastre que justamente queremos evitar.
MP_WEBHOOK_SECRET=

# ─── Resend (emails transaccionales) ────────────────────────
RESEND_API_KEY=
EMAIL_FROM=Código Rojo <onboarding@resend.dev>
ADMIN_EMAIL=

# ─── App ────────────────────────────────────────────────────
# URL base pública (sin barra final). En prod, el dominio https real.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Número de WhatsApp para coordinar entregas (formato internacional sin +)
NEXT_PUBLIC_WHATSAPP_NUMBER=
