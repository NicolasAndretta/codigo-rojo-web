# ─── Supabase ───────────────────────────────────────────────
# URL del proyecto (sin /rest/v1/ al final)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clave service_role — SOLO server-side, nunca exponer al cliente
SUPABASE_SERVICE_ROLE_KEY=

# ─── MercadoPago (Checkout Pro) ─────────────────────────────
# Usá el Access Token de TEST en desarrollo (empieza con TEST-)
MP_ACCESS_TOKEN=
# Clave secreta del webhook. Se genera en el panel de MercadoPago →
# "Tus integraciones" → la aplicación → Webhooks → "Generar clave secreta".
# Sirve para comprobar que la notificación la mandó MP de verdad.
# OPCIONAL: si está vacía, el webhook igual funciona (deja un aviso en el log).
# Se hizo así a propósito — si faltara y el webhook rechazara todo, ningún pago
# se confirmaría, que es el desastre que justamente queremos evitar.
MP_WEBHOOK_SECRET=

# ─── Resend (emails transaccionales) ────────────────────────
RESEND_API_KEY=
EMAIL_FROM=Código Rojo <onboarding@resend.dev>
ADMIN_EMAIL=

# ─── App ────────────────────────────────────────────────────
# URL base pública (sin barra final). En prod, el dominio https real.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Número de WhatsApp para coordinar entregas (formato internacional sin +)
NEXT_PUBLIC_WHATSAPP_NUMBER=
